{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wasper ASR Quality Benchmark v1 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "benchmarkRevision", "warmup", "fixtures"],
  "properties": {
    "schemaVersion": { "const": "asr-quality-manifest-v1" },
    "benchmarkRevision": { "$ref": "#/$defs/nonEmptyString" },
    "warmup": { "$ref": "#/$defs/warmupFixture" },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [{ "$ref": "#/$defs/scoredFixture" }, { "$ref": "#/$defs/noQualifiedLongFixture" }]
      }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "reportMetadataString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]*$"
    },
    "httpsUrl": {
      "type": "string",
      "minLength": 1,
      "format": "uri",
      "pattern": "^https://"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "opaqueSpeakerKey": { "type": "string", "pattern": "^spk_[a-f0-9]{16}$" },
    "fixtureIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:no-qualified-long(?:-|$)|__proto__$|prototype$|constructor$))[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection",
        "release",
        "partition",
        "recordingId",
        "mediaType",
        "sha256",
        "durationSeconds"
      ],
      "oneOf": [{ "required": ["url"] }, { "required": ["authorizedFetchKey"] }],
      "properties": {
        "collection": { "$ref": "#/$defs/reportMetadataString" },
        "release": { "$ref": "#/$defs/nonEmptyString" },
        "partition": { "enum": ["test", "validation", "standalone-recording"] },
        "recordingId": { "$ref": "#/$defs/nonEmptyString" },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "authorizedFetchKey": { "$ref": "#/$defs/nonEmptyString" },
        "mediaType": { "$ref": "#/$defs/nonEmptyString" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "normalizedAudio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "durationSeconds", "transform"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "transform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wholeRecording", "sampleRateHz", "channels", "codec", "tool", "arguments"],
          "properties": {
            "wholeRecording": { "const": true },
            "sampleRateHz": { "const": 16000 },
            "channels": { "const": 1 },
            "codec": { "const": "pcm_s16le" },
            "tool": { "const": "ffmpeg" },
            "arguments": {
              "const": [
                "-nostdin",
                "-hide_banner",
                "-loglevel",
                "error",
                "-i",
                "{sourcePath}",
                "-map_metadata",
                "-1",
                "-vn",
                "-ar",
                "16000",
                "-ac",
                "1",
                "-c:a",
                "pcm_s16le",
                "{temporaryWavPath}"
              ]
            }
          }
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "storagePolicy", "sha256", "wordCount", "characterCount"],
      "properties": {
        "text": { "$ref": "#/$defs/nonEmptyString" },
        "source": { "$ref": "#/$defs/nonEmptyString" },
        "storagePolicy": { "enum": ["redistributable", "restricted-local-cache"] },
        "authorizedFetchKey": { "$ref": "#/$defs/nonEmptyString" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "wordCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "characterCount": { "type": "integer", "minimum": 0, "maximum": 10000 }
      },
      "allOf": [
        {
          "if": { "properties": { "storagePolicy": { "const": "redistributable" } } },
          "then": { "required": ["text"] }
        },
        {
          "if": { "properties": { "storagePolicy": { "const": "restricted-local-cache" } } },
          "then": {
            "required": ["authorizedFetchKey"],
            "properties": { "text": false }
          }
        }
      ]
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "attribution", "accessNotes", "redistributionNotes"],
      "properties": {
        "identifier": { "$ref": "#/$defs/reportMetadataString" },
        "attribution": { "$ref": "#/$defs/nonEmptyString" },
        "accessNotes": { "$ref": "#/$defs/nonEmptyString" },
        "redistributionNotes": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audioReferenceStatus",
        "partitionStatus",
        "provenanceClassification",
        "recordingCondition",
        "userDataStatus",
        "benchmarkRevision",
        "auditor",
        "date"
      ],
      "properties": {
        "audioReferenceStatus": { "const": "audited" },
        "partitionStatus": { "const": "verified-non-training" },
        "provenanceClassification": {
          "enum": [
            "public-licensed-benchmark-corpus",
            "owned-or-commissioned-benchmark-recording"
          ]
        },
        "recordingCondition": {
          "enum": [
            "studio-or-close-talk",
            "consumer-device-quiet",
            "consumer-device-noisy",
            "far-field",
            "telephony"
          ]
        },
        "userDataStatus": { "const": "verified-no-user-data" },
        "benchmarkRevision": { "$ref": "#/$defs/nonEmptyString" },
        "speakerCompositionStatus": { "const": "predominantly-one-speaker" },
        "ownershipRightsStatus": { "const": "verified-benchmark-use-rights" },
        "participantConsentStatus": {
          "const": "verified-recording-and-transcription-consent"
        },
        "auditor": { "$ref": "#/$defs/nonEmptyString" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provenanceClassification": {
                "const": "owned-or-commissioned-benchmark-recording"
              }
            }
          },
          "then": {
            "required": ["ownershipRightsStatus", "participantConsentStatus"]
          }
        }
      ]
    },
    "scoredFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "benchmarkRevision",
        "language",
        "cohort",
        "speakerKey",
        "source",
        "normalizedAudio",
        "reference",
        "license",
        "audit",
        "excluded"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/fixtureIdentifier" },
        "benchmarkRevision": { "$ref": "#/$defs/nonEmptyString" },
        "language": { "enum": ["de", "el", "en", "es", "fr", "it", "nl", "pl", "pt"] },
        "cohort": { "enum": ["short", "long"] },
        "speakerKey": { "$ref": "#/$defs/opaqueSpeakerKey" },
        "source": { "$ref": "#/$defs/source" },
        "normalizedAudio": { "$ref": "#/$defs/normalizedAudio" },
        "reference": { "$ref": "#/$defs/reference" },
        "license": { "$ref": "#/$defs/license" },
        "audit": { "$ref": "#/$defs/audit" },
        "excluded": { "type": "boolean" },
        "exclusionReason": { "$ref": "#/$defs/nonEmptyString" }
      },
      "allOf": [
        {
          "if": { "properties": { "cohort": { "const": "short" } } },
          "then": {
            "properties": {
              "source": {
                "properties": { "partition": { "enum": ["test", "validation"] } }
              }
            }
          }
        },
        {
          "if": { "properties": { "cohort": { "const": "long" } } },
          "then": {
            "properties": {
              "source": {
                "properties": {
                  "partition": { "enum": ["test", "validation", "standalone-recording"] }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "excluded": { "const": true } } },
          "then": { "required": ["exclusionReason"] }
        },
        {
          "if": {
            "properties": {
              "cohort": { "const": "long" },
              "excluded": { "const": false }
            }
          },
          "then": {
            "properties": {
              "audit": { "required": ["speakerCompositionStatus"] }
            }
          }
        }
      ]
    },
    "warmupFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "benchmarkRevision",
        "language",
        "cohort",
        "speakerKey",
        "source",
        "normalizedAudio",
        "reference",
        "license",
        "audit",
        "excluded"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/fixtureIdentifier" },
        "benchmarkRevision": { "$ref": "#/$defs/nonEmptyString" },
        "language": { "enum": ["de", "el", "en", "es", "fr", "it", "nl", "pl", "pt"] },
        "cohort": { "const": "warmup" },
        "speakerKey": { "$ref": "#/$defs/opaqueSpeakerKey" },
        "source": {
          "allOf": [
            { "$ref": "#/$defs/source" },
            {
              "properties": {
                "partition": { "enum": ["test", "validation"] }
              }
            }
          ]
        },
        "normalizedAudio": { "$ref": "#/$defs/normalizedAudio" },
        "reference": { "$ref": "#/$defs/reference" },
        "license": { "$ref": "#/$defs/license" },
        "audit": { "$ref": "#/$defs/audit" },
        "excluded": { "const": false }
      }
    },
    "noQualifiedLongFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "cohort", "status", "reason"],
      "properties": {
        "language": { "enum": ["de", "el", "en", "es", "fr", "it", "nl", "pl", "pt"] },
        "cohort": { "const": "long" },
        "status": { "const": "no-qualified-fixture" },
        "reason": { "$ref": "#/$defs/reportMetadataString" }
      }
    }
  }
}
